# MongoDB Database Configuration
# Copy this to .env.local and set in Render environment variables
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/PassON?retryWrites=true&w=majority

# Cloudinary Configuration
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# App Branding
NEXT_PUBLIC_APP_NAME="Pass ON"
NEXT_PUBLIC_APP_TAGLINE="Pass It On. Save More."
